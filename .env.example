# ------------------------------------------------------------------
# Mercan model sunucusu (OpenAI uyumlu: mercan-server, vLLM, llama.cpp ...)
# mercan-server varsayılanı: http://127.0.0.1:8765/v1
#   mercan-server --model model.mercan --port 8765
# ------------------------------------------------------------------
MERCAN_API_BASE_URL=http://127.0.0.1:8765/v1
MERCAN_API_KEY=

# Model bazında ayrı sunucu / model adı (boşsa yukarıdaki ortak değerler kullanılır)
MERCAN_0_8B_BASE_URL=
MERCAN_0_8B_MODEL=mercan-0.8b
MERCAN_1_7B_BASE_URL=
MERCAN_1_7B_MODEL=mercan-1.7b

# Akıl yürütme düğmesi:
#   model    -> "<model>-dusunen" kimliği istenir (mercan-server bu şekilde çalışır)
#   template -> chat_template_kwargs.enable_thinking=true gönderilir (vLLM vb.)
MERCAN_REASONING_STYLE=model
MERCAN_THINK_SUFFIX=-dusunen

# Demo modu (yalnızca arayüzü denemek için):
#   true  -> her zaman örnek yanıt
#   auto  -> model sunucusu hazır değilse örnek yanıt, hazırsa gerçek model
#   false -> her zaman gerçek model (canlıda bunu kullanın)
MERCAN_DEMO_MODE=false

# Web araması: duckduckgo (varsayılan, anahtarsız) | searxng | tavily
# Sonuç bulunamazsa Türkçe Vikipedi araması yedek olarak kullanılır.
WEB_SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
